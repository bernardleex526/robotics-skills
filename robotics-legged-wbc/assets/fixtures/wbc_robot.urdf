<?xml version="1.0"?>
<robot name="fixture_quadruped">
  <link name="base_link">
    <inertial>
      <mass value="10"/>
      <inertia ixx="1" ixy="0" ixz="0" iyy="1.2" iyz="0" izz="1.4"/>
    </inertial>
  </link>
  <link name="fl_leg">
    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
  </link>
  <link name="fr_leg">
    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
  </link>
  <link name="rl_leg">
    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
  </link>
  <link name="rr_leg">
    <inertial><mass value="1"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/></inertial>
  </link>
  <link name="fl_foot"/>
  <link name="fr_foot"/>
  <link name="rl_foot"/>
  <link name="rr_foot"/>
  <joint name="fl_hip" type="revolute">
    <parent link="base_link"/><child link="fl_leg"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="60" velocity="10"/>
  </joint>
  <joint name="fr_hip" type="revolute">
    <parent link="base_link"/><child link="fr_leg"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="60" velocity="10"/>
  </joint>
  <joint name="rl_hip" type="revolute">
    <parent link="base_link"/><child link="rl_leg"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="60" velocity="10"/>
  </joint>
  <joint name="rr_hip" type="revolute">
    <parent link="base_link"/><child link="rr_leg"/><axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="60" velocity="10"/>
  </joint>
  <joint name="fl_foot_fixed" type="fixed"><parent link="fl_leg"/><child link="fl_foot"/></joint>
  <joint name="fr_foot_fixed" type="fixed"><parent link="fr_leg"/><child link="fr_foot"/></joint>
  <joint name="rl_foot_fixed" type="fixed"><parent link="rl_leg"/><child link="rl_foot"/></joint>
  <joint name="rr_foot_fixed" type="fixed"><parent link="rr_leg"/><child link="rr_foot"/></joint>
</robot>
