<?xml version="1.0"?>
<robot name="two_joint_arm">
  <link name="base_link"/>
  <link name="link_1"/>
  <link name="tool0"/>
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.0" upper="2.0" effort="20.0" velocity="1.5"/>
  </joint>
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="tool0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5" upper="1.5" effort="15.0" velocity="1.0"/>
  </joint>
  <ros2_control name="arm_system" type="system">
    <hardware>
      <plugin>example/ReadOnlyFixture</plugin>
    </hardware>
    <joint name="joint_1">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
    <joint name="joint_2">
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>
</robot>
